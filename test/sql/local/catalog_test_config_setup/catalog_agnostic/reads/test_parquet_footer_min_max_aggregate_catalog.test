# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/test_parquet_footer_min_max_aggregate_catalog.test
# description: Parquet footer MIN/MAX folding for DuckDB-written Iceberg tables, and correctness after deletes
# group: [reads]

require-env CATALOG_TEST_CONFIG_SETUP

require avro

require parquet

require iceberg

require httpfs

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
set logging_level='debug'

# This test exercises IcebergParquetPartitionRowGroup / GetStatistics (Option B): duckdb-iceberg reads per-file
# Parquet footer statistics and exposes them to DuckDB's optimizer so bare MIN/MAX/COUNT(*) can fold to constants
# without reading Parquet column data. It requires a catalog-backed INSERT so files are written by DuckDB's
# Parquet writer, which sets is_min_value_exact / is_max_value_exact on column stats.
#
# Companion test (external writer, no exact flags, fallback scan only):
#   test/sql/local/iceberg_scans/parquet_footer_min_max_aggregate.test

statement ok
DROP TABLE IF EXISTS my_datalake.default.test_footer_min_max;

statement ok
CREATE TABLE my_datalake.default.test_footer_min_max (id INTEGER, value VARCHAR);

# --- Append-only table: footer folding should be allowed ---
#
# Three rows with known min/max on both columns. On an append-only table (no delete manifests),
# GetStatistics emits footer-derived partition stats and the optimizer may fold MIN/MAX/COUNT(*)
# straight from the Parquet footer.
statement ok
INSERT INTO my_datalake.default.test_footer_min_max VALUES (1, 'bar'), (2, 'baz'), (3, 'foo');

query III
SELECT min(id), max(id), count(*) FROM my_datalake.default.test_footer_min_max;
----
1	3	3

query II
SELECT min(value), max(value) FROM my_datalake.default.test_footer_min_max;
----
bar	foo

# With statistics_propagation disabled the optimizer cannot fold from footer stats and must scan
# column data. Results must match the optimizer-on path above; if they differ, folding returned
# a wrong constant.
statement ok
SET disabled_optimizers='statistics_propagation';

query III
SELECT min(id), max(id), count(*) FROM my_datalake.default.test_footer_min_max;
----
1	3	3

query II
SELECT min(value), max(value) FROM my_datalake.default.test_footer_min_max;
----
bar	foo

statement ok
SET disabled_optimizers='';

# --- Table with deletes: footer folding must NOT be used ---
#
# DELETE creates a delete manifest. GetStatistics bails out entirely when any delete manifest is
# present, because Parquet footer min/max describe the file as written and do not account for rows
# removed by positional/equality deletes. If folding still used the footer, MAX(id) would be 3 and
# MAX(value) would be 'foo' even though row id=3 was deleted.
statement ok
DELETE FROM my_datalake.default.test_footer_min_max WHERE id = 3;

query III
SELECT min(id), max(id), count(*) FROM my_datalake.default.test_footer_min_max;
----
1	2	2

query II
SELECT min(value), max(value) FROM my_datalake.default.test_footer_min_max;
----
bar	baz

# Same optimizer-on vs optimizer-off comparison after deletes: aggregates must still be correct
# via a real scan, not stale footer bounds.
statement ok
SET disabled_optimizers='statistics_propagation';

query III
SELECT min(id), max(id), count(*) FROM my_datalake.default.test_footer_min_max;
----
1	2	2

query II
SELECT min(value), max(value) FROM my_datalake.default.test_footer_min_max;
----
bar	baz

statement ok
SET disabled_optimizers='';
