# name: test/sql/local/iceberg_scans/manifest_min_max_aggregate.test
# description: Manifest-bound MIN/MAX/COUNT(*) folding for bare aggregates on Iceberg tables
# group: [iceberg_scans]

require avro

require parquet

require iceberg

require icu

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

# is_null_is_not_null has 3 data files with non-overlapping id bounds: [1,3], [4,6], [7,8].

statement ok
CREATE VIEW id_bounds AS SELECT * FROM iceberg_scan('{WORKING_DIRECTORY}/data/persistent/is_null_is_not_null');

query I
SELECT max(id) FROM id_bounds;
----
8

query I
SELECT min(id) FROM id_bounds;
----
1

query I
SELECT count(*) FROM id_bounds;
----
8

# Folded plan should not scan parquet data files.
query II
EXPLAIN SELECT max(id) FROM id_bounds;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

query II
EXPLAIN SELECT max(id) FROM id_bounds;
----
physical_plan	<!REGEX>:.*ICEBERG_SCAN.*

query II
EXPLAIN SELECT min(id), max(id), count(*) FROM id_bounds;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

query II
EXPLAIN SELECT min(id), max(id), count(*) FROM id_bounds;
----
physical_plan	<!REGEX>:.*ICEBERG_SCAN.*

# Filter + aggregate uses manifest bounds for partition pruning but still scans remaining files.
query I
SELECT max(id) FROM id_bounds WHERE id >= 5;
----
8

query II
EXPLAIN SELECT max(id) FROM id_bounds WHERE id >= 5;
----
physical_plan	<REGEX>:.*ICEBERG_SCAN.*

query II
EXPLAIN SELECT max(id) FROM id_bounds WHERE id >= 5;
----
physical_plan	<!REGEX>:.*COLUMN_DATA_SCAN.*

# Grouped MAX must not constant-fold.
query II
EXPLAIN SELECT max(id) FROM id_bounds GROUP BY id % 2;
----
physical_plan	<REGEX>:.*HASH_GROUP_BY.*

query II
EXPLAIN SELECT max(id) FROM id_bounds GROUP BY id % 2;
----
physical_plan	<!REGEX>:.*COLUMN_DATA_SCAN.*

# VARCHAR manifest bounds are truncated; MAX must scan data files.
query I
SELECT max(value) FROM id_bounds;
----
foo

query II
EXPLAIN SELECT max(value) FROM id_bounds;
----
physical_plan	<REGEX>:.*ICEBERG_SCAN.*

query II
EXPLAIN SELECT max(value) FROM id_bounds;
----
physical_plan	<!REGEX>:.*COLUMN_DATA_SCAN.*

statement ok
SET disabled_optimizers='statistics_propagation';

query I
SELECT max(value) FROM id_bounds;
----
foo

statement ok
RESET disabled_optimizers;

# Optimizer-off path must match (proves correctness without folding).
statement ok
SET disabled_optimizers='statistics_propagation';

query III
SELECT min(id), max(id), count(*) FROM id_bounds;
----
1	8	8

statement ok
RESET disabled_optimizers;

# hive_partitioned_table has exact per-file BIGINT bounds on user_id.
statement ok
CREATE VIEW hive_stats AS SELECT * FROM iceberg_scan('{WORKING_DIRECTORY}/data/persistent/hive_partitioned_table', allow_moved_paths=true);

query I
SELECT max(user_id) FROM hive_stats;
----
97531

query I
SELECT min(user_id) FROM hive_stats;
----
12345

query I
SELECT count(*) FROM hive_stats;
----
6

query II
EXPLAIN SELECT max(user_id) FROM hive_stats;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

query II
EXPLAIN SELECT max(user_id) FROM hive_stats;
----
physical_plan	<!REGEX>:.*ICEBERG_SCAN.*

# Multi-file TIMESTAMP table written at runtime should fully fold MAX(ts).
statement ok
COPY (SELECT (range)::BIGINT AS id, ('2024-01-01'::TIMESTAMP + range * interval '1 second') AS ts FROM range(3000000)) TO '{TEST_DIR}/manifest_ts_fold' (FORMAT ICEBERG);

statement ok
CREATE VIEW ts_fold AS SELECT ts FROM iceberg_scan('{TEST_DIR}/manifest_ts_fold');

query I
SELECT max(ts) FROM ts_fold;
----
2024-02-04 17:19:59

query II
EXPLAIN SELECT max(ts) FROM ts_fold;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

query II
EXPLAIN SELECT max(ts) FROM ts_fold;
----
physical_plan	<!REGEX>:.*ICEBERG_SCAN.*

# Multi-file TIMESTAMPTZ table written at runtime should fully fold MAX(ts).
statement ok
SET TimeZone='UTC';

statement ok
COPY (SELECT (range)::BIGINT AS id, ('2024-01-01'::TIMESTAMPTZ + (range::BIGINT * interval '1 second')) AS ts FROM range(3000000)) TO '{TEST_DIR}/manifest_tstz_fold' (FORMAT ICEBERG);

statement ok
CREATE VIEW tstz_fold AS SELECT ts FROM iceberg_scan('{TEST_DIR}/manifest_tstz_fold');

query I
SELECT max(ts) FROM tstz_fold;
----
2024-02-04 17:19:59+00

query II
EXPLAIN SELECT max(ts) FROM tstz_fold;
----
physical_plan	<REGEX>:.*COLUMN_DATA_SCAN.*

query II
EXPLAIN SELECT max(ts) FROM tstz_fold;
----
physical_plan	<!REGEX>:.*ICEBERG_SCAN.*

# Overlapping bounds must not change results when folding is active.
statement ok
COPY (select (hash(range) % 1000000)::BIGINT a from range(3000000)) TO '{TEST_DIR}/manifest_min_max_overlap' (FORMAT ICEBERG);

statement ok
CREATE VIEW overlap AS SELECT a FROM iceberg_scan('{TEST_DIR}/manifest_min_max_overlap');

statement ok
SET disabled_optimizers='statistics_propagation';

statement ok
CREATE TABLE overlap_oracle AS SELECT max(a) AS max_a, min(a) AS min_a, count(*) AS cnt FROM overlap;

statement ok
RESET disabled_optimizers;

query I
SELECT count(*) FROM (
  (SELECT max(a), min(a), count(*) FROM overlap)
  EXCEPT
  (SELECT max_a, min_a, cnt FROM overlap_oracle)
);
----
0

query I
SELECT count(*) FROM (
  (SELECT max_a, min_a, cnt FROM overlap_oracle)
  EXCEPT
  (SELECT max(a), min(a), count(*) FROM overlap)
);
----
0
